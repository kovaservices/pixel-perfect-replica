// Configuración de Cloudflare Workers. Astro completa el resto al compilar
// (entrada del servidor, carpeta de archivos estáticos…).
{
	"name": "kova-web",
	"compatibility_date": "2026-04-15",
	// Compatibilidad con módulos de Node para la función del formulario.
	"compatibility_flags": ["nodejs_compat"]
}
