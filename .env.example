# Copia este archivo como .env y rellena los valores. Nunca subas .env a GitHub.

# Dirección final de la web (para Google y redes sociales)
SITE_URL=https://kovaservice.es

# Formularios (Forminit · https://forminit.com)
# Identificador del formulario: lo ves en el panel de Forminit al crear el formulario.
# Si lo dejas vacío, en local los mensajes solo aparecen en la terminal.
FORMINIT_FORM_ID=
# Opcional: clave de API de Forminit (permite más envíos por minuto)
FORMINIT_API_KEY=

# Tina Cloud: no se usa. La web se edita en local y /admin no se publica.
# Solo harían falta con `npm run build:tina-cloud` (ver README, «Editar desde la web publicada»).
PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=
