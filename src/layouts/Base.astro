---
import '@fontsource-variable/plus-jakarta-sans';
import '../styles/global.css';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { islands } from '../lib/islands';
import type { Settings } from '../lib/data';

interface Props { title: string; description: string; settings?: Settings | null; image?: string | null }
const { title, description, settings, image } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image || '/og-kova.png', Astro.site);
const sameAs = Object.values(settings?.social ?? {}).filter((v): v is string => typeof v === 'string' && /^https?:\/\//.test(v));
// Datos estructurados: ayudan a Google a entender que Kova es un negocio local.
const schema = {
	'@context': 'https://schema.org',
	'@type': 'ProfessionalService',
	name: 'Kova',
	description,
	url: new URL('/', Astro.site).href,
	logo: new URL('/kova-logo.svg', Astro.site).href,
	image: ogImage.href,
	areaServed: settings?.location ?? 'Ciudad Real',
	address: { '@type': 'PostalAddress', addressLocality: settings?.location ?? 'Ciudad Real', addressCountry: 'ES' },
	...(settings?.email?.includes('@') ? { email: settings.email } : {}),
	...(/\d{6,}/.test((settings?.phone ?? '').replace(/\s/g, '')) ? { telephone: settings?.phone } : {}),
	...(sameAs.length ? { sameAs } : {}),
};
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" content="#05031C" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content="Kova" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={ogImage} />
		<script type="application/ld+json" set:html={JSON.stringify(schema)} />
		<script is:inline>
			// Dentro del editor de Tina la web se muestra en un iframe.
			if (window.self !== window.top) document.documentElement.classList.add('tina-edit');
		</script>
	</head>
	<body>
		<TinaIsland name="header" wrapper={islands.header.wrapper}>
			<Header settings={settings} />
		</TinaIsland>
		<slot />
		<TinaIsland name="footer" wrapper={islands.footer.wrapper}>
			<Footer settings={settings} />
		</TinaIsland>

		<script>
			// Interacciones de la página. Se usa delegación de eventos porque el
			// editor de Tina vuelve a pintar zonas de la web mientras se edita.

			const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			// 1. Cabecera: cambia de estilo al hacer scroll
			function updateHeader() {
				document.getElementById('site-header')?.setAttribute('data-scrolled', String(window.scrollY > 20));
			}

			// 2. Línea de progreso de "Cómo trabajamos"
			function updateProcess() {
				const el = document.getElementById('process-track');
				if (!el) return;
				const r = el.getBoundingClientRect();
				const vh = window.innerHeight;
				const p = Math.min(1, Math.max(0, (vh * 0.85 - r.top) / (r.height + vh * 0.3)));
				el.style.setProperty('--progress', String(p));
			}

			window.addEventListener('scroll', () => { updateHeader(); updateProcess(); }, { passive: true });
			window.addEventListener('resize', updateProcess);

			// 3. Elementos que aparecen al hacer scroll
			const io = new IntersectionObserver((entries) => {
				for (const e of entries) {
					if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
				}
			}, { threshold: 0.12 });

			function watchReveals(root: ParentNode = document) {
				root.querySelectorAll('.reveal:not(.is-visible)').forEach((el) => {
					if (reduceMotion || document.documentElement.classList.contains('tina-edit')) el.classList.add('is-visible');
					else io.observe(el);
				});
			}

			// Cuando Tina vuelve a pintar una zona, se preparan sus elementos nuevos
			new MutationObserver(() => { watchReveals(); updateHeader(); updateProcess(); })
				.observe(document.body, { childList: true, subtree: true });

			// 4. Clics: menú móvil, preguntas frecuentes y ventana de proyectos
			document.addEventListener('click', (ev) => {
				const target = ev.target as HTMLElement;

				const menuBtn = target.closest('#mobile-menu-toggle');
				if (menuBtn) {
					const open = menuBtn.getAttribute('aria-expanded') !== 'true';
					menuBtn.setAttribute('aria-expanded', String(open));
					const panel = document.getElementById('mobile-menu');
					if (panel) panel.hidden = !open;
					return;
				}
				if (target.closest('#mobile-menu a')) {
					document.getElementById('mobile-menu-toggle')?.setAttribute('aria-expanded', 'false');
					const panel = document.getElementById('mobile-menu');
					if (panel) panel.hidden = true;
				}

				const faqBtn = target.closest('[data-faq-toggle]');
				if (faqBtn) {
					const item = faqBtn.closest('.faq-item') as HTMLElement | null;
					if (!item) return;
					const open = item.dataset.open !== 'true';
					item.parentElement?.querySelectorAll<HTMLElement>('.faq-item').forEach((other) => {
						other.dataset.open = 'false';
						other.querySelector('[data-faq-toggle]')?.setAttribute('aria-expanded', 'false');
					});
					item.dataset.open = String(open);
					faqBtn.setAttribute('aria-expanded', String(open));
					return;
				}

				// Botón de un servicio: deja ese servicio elegido en el formulario de contacto
				const serviceLink = target.closest('[data-service]') as HTMLElement | null;
				if (serviceLink) {
					const select = document.querySelector<HTMLSelectElement>('#contacto select[name="servicio"]');
					const value = serviceLink.dataset.service ?? '';
					if (select && [...select.options].some((o) => o.value === value)) select.value = value;
				}

				const card = target.closest('[data-project]') as HTMLElement | null;
				const dialog = document.getElementById('project-dialog') as HTMLDialogElement | null;
				if (card && dialog) {
					const d = card.dataset;
					const set = (slot: string, fn: (el: HTMLElement) => void) => {
						const el = dialog.querySelector<HTMLElement>(`[data-slot="${slot}"]`);
						if (el) fn(el);
					};
					set('image', (el) => { (el as HTMLImageElement).src = d.image ?? ''; (el as HTMLImageElement).alt = `Captura de ${d.name}`; el.hidden = !d.image; });
					set('tag', (el) => { el.textContent = d.tag ?? ''; el.hidden = !d.tag; });
					set('name', (el) => { el.textContent = d.name ?? ''; });
					set('description', (el) => { el.textContent = d.description ?? ''; });
					set('url', (el) => { (el as HTMLAnchorElement).href = d.url || '#'; el.hidden = !d.url; });
					dialog.showModal();
					return;
				}
				if (dialog?.open && (target.closest('[data-close-dialog]') || target === dialog)) dialog.close();
			});

			// 5. Formularios: se envían a /api/contacto sin salir de la página
			document.addEventListener('submit', async (ev) => {
				const form = ev.target as HTMLFormElement;
				if (!form.matches('[data-contact-form]')) return;
				ev.preventDefault();

				const source = (form.elements.namedItem('origen') as HTMLInputElement | null)?.value ?? '';
				const status = form.querySelector<HTMLElement>('[data-form-status]')
					?? form.parentElement?.querySelector<HTMLElement>(`[data-form-status][data-for="${source}"]`)
					?? null;
				const show = (state: 'ok' | 'error' | 'sending', text: string) => {
					if (!status) return;
					status.hidden = false;
					status.dataset.state = state;
					status.textContent = text;
				};

				const fd = new FormData(form);
				const data: Record<string, string | boolean> = {};
				fd.forEach((v, k) => { if (typeof v === 'string') data[k] = v; });
				const consent = form.querySelector<HTMLInputElement>('input[name="privacidad"]');
				if (consent) data.privacidad = consent.checked;

				const hasEmailField = !!form.querySelector('[name="email"]');
				const hasPhoneField = !!form.querySelector('[name="telefono"]');
				if (hasEmailField && hasPhoneField && !String(data.email ?? '').trim() && !String(data.telefono ?? '').trim()) {
					show('error', 'Déjanos un email o un teléfono para poder responderte.');
					return;
				}

				const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
				if (button) button.disabled = true;
				show('sending', 'Enviando…');
				try {
					const res = await fetch(form.action, {
						method: 'POST',
						headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
						body: JSON.stringify(data),
					});
					const body = await res.json().catch(() => ({}));
					if (res.ok && body.ok) {
						form.reset();
						show('ok', body.demo
							? 'Mensaje de prueba recibido. El formulario aún no está conectado a Forminit, así que no se ha enviado.'
							: '¡Gracias! Hemos recibido tu mensaje y te responderemos en menos de 24 horas.');
					} else {
						show('error', body.message || 'No hemos podido enviar el mensaje. Inténtalo de nuevo o escríbenos por WhatsApp.');
					}
				} catch {
					show('error', 'No hemos podido enviar el mensaje. Revisa tu conexión e inténtalo de nuevo.');
				} finally {
					if (button) button.disabled = false;
				}
			});

			updateHeader();
			updateProcess();
			watchReveals();
		</script>
	</body>
</html>
