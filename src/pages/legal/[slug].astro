---
import Base from '../../layouts/Base.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import LegalBody from '../../components/LegalBody.astro';
import { getLegal, getSettings, listLegal } from '../../lib/data';
import { islands } from '../../lib/islands';

export async function getStaticPaths() {
	const docs = await listLegal();
	return docs.map((d) => ({ params: { slug: d._sys.filename } }));
}

const { slug } = Astro.params;
const legal = (await getLegal(slug)).data?.legal;
if (!legal) return new Response('Not Found', { status: 404 });
const settings = (await getSettings()).data?.settings ?? null;
---
<Base title={`${legal.title} · Kova`} description={`${legal.title} de Kova.`} settings={settings}>
	<TinaIsland name="legal" wrapper={islands.legal.wrapper} params={{ slug }} primary>
		<LegalBody data={legal} />
	</TinaIsland>
</Base>
