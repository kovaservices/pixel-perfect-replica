---
/**
 * Página de cada caso de cliente. Los textos están en
 * src/content/proyectos/<dirección>.json. La reseña solo aparece cuando
 * se rellena el campo «review.text» con una reseña real del cliente.
 */
import { Icon } from 'astro-icon/components';
import Base from '../../layouts/Base.astro';
import Btn from '../../components/ui/Btn.astro';
import SectionHead from '../../components/ui/SectionHead.astro';
import Contact from '../../components/sections/Contact.astro';
import { getHome, getProjectPages, getSettings, list, type ProjectPage } from '../../lib/data';
import { breadcrumbs } from '../../lib/schema';

export function getStaticPaths() {
	return getProjectPages().map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props as { page: ProjectPage };
const home = getHome();
const settings = getSettings();
const site = Astro.site!;
const url = new URL(page.href, site);
const review = page.review;
const hasReview = !!review.text.trim();
const schema = [
	{
		'@type': 'CreativeWork',
		'@id': `${url.href}#caso`,
		name: `Web de ${page.name}`,
		description: page.seo.description,
		url: page.url,
		image: new URL(page.image, site).href,
		creator: { '@id': new URL('/#kova', site).href },
		about: { '@type': 'Organization', name: page.name, url: page.url },
	},
	breadcrumbs(site, [{ name: 'Proyectos', path: '/#proyectos' }, { name: page.name, path: page.href }]),
];
const contactServices = list(home.services.items).map((s) => s.title ?? '').filter(Boolean);
const desktop = page.gallery.filter((g) => g.kind === 'desktop');
const mobile = page.gallery.filter((g) => g.kind === 'mobile');
---
<Base title={page.seo.title} description={page.seo.description} image={page.image} settings={settings} schema={schema}>
	<main>
		<section class="section-ink grid-texture overflow-hidden pt-32 pb-16 md:pt-40 md:pb-24">
			<div class="container-k">
				<nav aria-label="Migas de pan" class="text-sm text-ink-muted">
					<a href="/" class="hover:text-primary">Inicio</a> <span aria-hidden="true">/</span> <a href="/#proyectos" class="hover:text-primary">Proyectos</a> <span aria-hidden="true">/</span> <span>{page.name}</span>
				</nav>
				<div class="mt-6 grid items-center gap-12 lg:grid-cols-[1fr_1.15fr]">
					<div>
						<p class="eyebrow">Caso real · {page.tag}</p>
						<h1 class="mt-3 text-4xl font-extrabold leading-[1.08] md:text-5xl">{page.name}</h1>
						<p class="mt-6 text-lg text-ink-muted">{page.summary}</p>
						<div class="mt-8 flex flex-wrap gap-3">
							<Btn href={page.url} target="_blank" arrow>Visitar la web</Btn>
							<Btn href="#contacto" variant="outline-ink">Quiero algo así</Btn>
						</div>
					</div>
					<div class="rounded-xl border border-ink-border bg-ink-deep p-1.5 shadow-2xl">
						<img src={page.image} alt={`Portada de la web de ${page.name}`} width="1280" height="800" fetchpriority="high" class="aspect-[16/10] w-full rounded-lg object-cover object-top" />
					</div>
				</div>
			</div>
		</section>

		<section class="py-16 md:py-20">
			<div class="container-k">
				<dl class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
					{page.facts.map((f) => (
						<div class="rounded-lg border bg-card p-5">
							<dt class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{f.label}</dt>
							<dd class="mt-2 font-semibold">{f.value}</dd>
						</div>
					))}
				</dl>
			</div>
		</section>

		<section class="pb-20 md:pb-28">
			<div class="container-k grid gap-12 lg:grid-cols-2 lg:gap-20">
				<div class="reveal">
					<SectionHead eyebrow="El cliente" title="Quiénes son" />
					<p class="mt-5 text-muted-foreground">{page.client}</p>
					<h2 class="mt-10 text-2xl font-extrabold">Qué necesitaban</h2>
					<p class="mt-4 text-muted-foreground">{page.challenge}</p>
				</div>
				<div class="reveal" style="transition-delay:100ms">
					<SectionHead eyebrow="Nuestro trabajo" title="Qué hicimos" />
					<ul class="mt-6 space-y-4">
						{page.solution.map((s) => <li class="flex gap-3"><Icon name="lucide:check" class="size-5 shrink-0 translate-y-0.5 text-primary-strong" />{s}</li>)}
					</ul>
				</div>
			</div>
		</section>

		<section class="bg-sand py-20 md:py-28">
			<div class="container-k">
				<div class="reveal max-w-2xl">
					<SectionHead eyebrow="El resultado" title="Así quedó" />
					<ul class="mt-6 space-y-3">
						{page.results.map((r) => <li class="flex gap-3"><Icon name="lucide:check" class="size-5 shrink-0 translate-y-0.5 text-primary-strong" />{r}</li>)}
					</ul>
				</div>
				<div class="mt-12 grid items-start gap-6 lg:grid-cols-[1fr_1fr_0.42fr_0.42fr]">
					{desktop.map((g) => (
						<figure class="reveal overflow-hidden rounded-lg border bg-card p-1.5 shadow-sm">
							<img src={g.src} alt={g.alt} loading="lazy" width="1280" height="800" class="aspect-[16/10] w-full rounded-md object-cover object-top" />
						</figure>
					))}
					<div class="grid grid-cols-2 gap-6 lg:contents">
						{mobile.map((g) => (
							<figure class="reveal overflow-hidden rounded-[1.2rem] border bg-card p-1.5 shadow-sm">
								<img src={g.src} alt={g.alt} loading="lazy" width="576" height="1216" class="aspect-[9/19] w-full rounded-[0.9rem] object-cover object-top" />
							</figure>
						))}
					</div>
				</div>
			</div>
		</section>

		{hasReview && (
			<section class="py-20 md:py-28">
				<div class="container-k max-w-3xl text-center">
					<Icon name="lucide:message-circle" class="mx-auto size-10 text-primary-strong" stroke-width="1.5" />
					<blockquote class="mt-6 text-2xl font-semibold leading-snug md:text-3xl">«{review.text}»</blockquote>
					<p class="mt-6 font-semibold">{review.author}</p>
					{review.role && <p class="text-sm text-muted-foreground">{review.role}</p>}
					{review.link && <a href={review.link} target="_blank" rel="noreferrer noopener" class="mt-3 inline-block text-sm font-semibold text-primary-strong hover:underline">Ver la reseña original</a>}
				</div>
			</section>
		)}

		<Contact data={{ ...home.contact, title: '¿Quieres una web así para tu negocio?', text: 'Cuéntanos qué necesitas y te preparamos un presupuesto cerrado, sin compromiso.' }} settings={settings} services={contactServices} />
	</main>
</Base>
