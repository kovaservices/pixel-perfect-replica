---
import Base from '../layouts/Base.astro';
import HomeBody from '../components/HomeBody.astro';
import { getHome, getSettings } from '../lib/data';

const home = getHome();
const settings = getSettings();
---
<Base title={home.seo.title} description={home.seo.description} image={home.seo.image} settings={settings}>
	<main>
		<HomeBody data={home} settings={settings} />
	</main>
</Base>
