---
import { Icon } from 'astro-icon/components';
import { tinaField } from '@tinacms/astro/tina-field';
import Logo from './Logo.astro';
import Btn from './ui/Btn.astro';
import { contactLinks, list, type Settings } from '../lib/data';

interface Props { settings?: Settings | null }
const { settings } = Astro.props;
const nav = list(settings?.nav);
const links = contactLinks(settings);
---
<header id="site-header" class="fixed inset-x-0 top-0 z-50 text-ink-foreground transition-all duration-300">
	<div class="header-row container-k flex h-20 items-center justify-between transition-all duration-300">
		<Logo settings={settings} />
		<nav class="hidden items-center gap-8 lg:flex" aria-label="Principal">
			{nav.map((n) => (
				<a href={n.link ?? '#'} class="text-sm font-medium text-ink-muted transition-colors hover:text-ink-foreground" data-tina-field={tinaField(n, 'label')}>{n.label}</a>
			))}
		</nav>
		<div class="hidden items-center gap-3 lg:flex">
			<Btn href={links.whatsapp} target="_blank" variant="outline-ink" class="py-2.5">WhatsApp</Btn>
			<Btn href="/#contacto" class="py-2.5" data-tina-field={settings ? tinaField(settings, 'headerButton') : undefined}>{settings?.headerButton ?? 'Pide presupuesto'}</Btn>
		</div>
		<button id="mobile-menu-toggle" type="button" class="p-2 lg:hidden" aria-label="Abrir menú" aria-controls="mobile-menu" aria-expanded="false">
			<Icon name="lucide:menu" class="icon-open size-6" />
			<Icon name="lucide:x" class="icon-close size-6" />
		</button>
	</div>
	<div id="mobile-menu" hidden class="border-t border-ink-border bg-ink lg:hidden">
		<div class="container-k flex flex-col gap-1 py-4">
			{nav.map((n) => <a href={n.link ?? '#'} class="py-3 font-medium">{n.label}</a>)}
			<div class="mt-3 grid grid-cols-2 gap-3">
				<Btn href={links.whatsapp} target="_blank" variant="outline-ink">WhatsApp</Btn>
				<Btn href="/#contacto">Presupuesto</Btn>
			</div>
		</div>
	</div>
</header>
