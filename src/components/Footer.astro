---
import { Icon } from 'astro-icon/components';
import { tinaField } from '@tinacms/astro/tina-field';
import Logo from './Logo.astro';
import { contactLinks, list, type Settings } from '../lib/data';

interface Props { settings?: Settings | null }
const { settings } = Astro.props;
const links = contactLinks(settings);
const services = list(settings?.services);
const legal = ['Aviso legal', 'Privacidad', 'Cookies'];
---
<footer class="bg-ink-deep text-ink-foreground">
	<div class="container-k grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
		<div>
			<Logo settings={settings} />
			<p class="mt-3 text-sm text-ink-muted" data-tina-field={settings ? tinaField(settings, 'location') : undefined}>{settings?.location}</p>
		</div>
		<div>
			<p class="text-sm font-bold">Servicios</p>
			<ul class="mt-4 space-y-2.5 text-sm text-ink-muted">
				{services.map((s, i) => <li data-tina-field={settings ? tinaField(settings, 'services', i) : undefined}>{s}</li>)}
			</ul>
		</div>
		<div>
			<p class="text-sm font-bold">Contacto</p>
			<ul class="mt-4 space-y-2.5 text-sm text-ink-muted">
				<li><a href={links.tel} class="transition-colors hover:text-primary" data-tina-field={settings ? tinaField(settings, 'phone') : undefined}>{settings?.phone}</a></li>
				<li><a href={links.mailto} class="transition-colors hover:text-primary" data-tina-field={settings ? tinaField(settings, 'email') : undefined}>{settings?.email}</a></li>
				<li><a href={links.whatsapp} target="_blank" rel="noreferrer noopener" class="transition-colors hover:text-primary">WhatsApp</a></li>
			</ul>
		</div>
		<div>
			<p class="text-sm font-bold">Legal</p>
			<ul class="mt-4 space-y-2.5 text-sm text-ink-muted">
				{legal.map((l) => <li><a href="#" class="transition-colors hover:text-primary">{l}</a></li>)}
			</ul>
		</div>
	</div>
	<div class="border-t border-ink-border">
		<p class="container-k py-6 text-sm text-ink-muted" data-tina-field={settings ? tinaField(settings, 'copyright') : undefined}>{settings?.copyright}</p>
	</div>
	<a href={links.whatsapp} target="_blank" rel="noreferrer noopener" aria-label="Escríbenos por WhatsApp"
		class="pulse-soft fixed bottom-5 right-5 z-40 grid size-14 place-items-center rounded-full bg-whatsapp text-white shadow-lg transition-transform hover:scale-105">
		<Icon name="lucide:message-circle" class="size-6" />
	</a>
</footer>
