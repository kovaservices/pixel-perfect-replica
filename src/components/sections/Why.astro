---
import { Icon } from 'astro-icon/components';
import { tinaField } from '@tinacms/astro/tina-field';
import SectionHead from '../ui/SectionHead.astro';
import { list, type Home } from '../../lib/data';

interface Props { data: NonNullable<Home['why']> }
const { data } = Astro.props;
const items = list(data.items);
---
<section class="bg-sand py-20 md:py-28">
	<div class="container-k">
		<div class="reveal">
			<SectionHead eyebrow={data.eyebrow} title={data.title} eyebrowField={tinaField(data, 'eyebrow')} titleField={tinaField(data, 'title')} />
		</div>
		<div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
			{items.map((w, i) => (
				<div class="reveal" style={`transition-delay:${i * 80}ms`}>
					<div class="card-lift h-full rounded-lg border bg-card p-6" data-tina-field={tinaField(w)}>
						<Icon name={`lucide:${w.icon || 'check'}`} class="size-8 text-primary-strong" stroke-width="1.5" data-tina-field={tinaField(w, 'icon')} />
						<h3 class="mt-5 text-lg font-bold" data-tina-field={tinaField(w, 'title')}>{w.title}</h3>
						<p class="mt-2 text-sm text-muted-foreground" data-tina-field={tinaField(w, 'text')}>{w.text}</p>
					</div>
				</div>
			))}
		</div>
	</div>
</section>
