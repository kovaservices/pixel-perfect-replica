---
import { Icon } from 'astro-icon/components';
import { tinaField } from '@tinacms/astro/tina-field';
import SectionHead from '../ui/SectionHead.astro';
import { list, type Home } from '../../lib/data';

interface Props { data: NonNullable<Home['services']> }
const { data } = Astro.props;
const items = list(data.items);
---
<section id="servicios" class="py-20 md:py-28">
	<div class="container-k">
		<div class="grid gap-6 lg:grid-cols-2 lg:items-end">
			<div class="reveal">
				<SectionHead eyebrow={data.eyebrow} title={data.title} eyebrowField={tinaField(data, 'eyebrow')} titleField={tinaField(data, 'title')} />
			</div>
			<p class="reveal text-muted-foreground lg:max-w-md lg:justify-self-end" style="transition-delay:100ms" data-tina-field={tinaField(data, 'text')}>{data.text}</p>
		</div>
		<div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
			{items.map((s, i) => (
				<div class="reveal" style={`transition-delay:${i * 90}ms`}>
					<div class="card-lift group flex h-full flex-col rounded-lg border bg-card p-7" data-tina-field={tinaField(s)}>
						<span class="grid size-12 place-items-center rounded-lg bg-primary/12 text-primary-strong transition-colors group-hover:bg-primary group-hover:text-primary-foreground" data-tina-field={tinaField(s, 'icon')}>
							<Icon name={`lucide:${s.icon || 'layout-template'}`} class="size-6" stroke-width="1.75" />
						</span>
						<h3 class="mt-6 text-xl font-bold" data-tina-field={tinaField(s, 'title')}>{s.title}</h3>
						<p class="mt-2 text-sm text-muted-foreground" data-tina-field={tinaField(s, 'text')}>{s.text}</p>
						<ul class="mt-5 space-y-2.5 text-sm">
							{list(s.features).map((f, j) => (
								<li class="flex gap-2.5" data-tina-field={tinaField(s, 'features', j)}>
									<Icon name="lucide:check" class="size-4 shrink-0 translate-y-0.5 text-primary-strong" />{f}
								</li>
							))}
						</ul>
						<a href="/#contacto" data-service={s.title ?? ''}
							class="btn-arrow mt-auto inline-flex items-center gap-2 pt-7 text-sm font-semibold text-primary-strong hover:underline"
							data-tina-field={tinaField(s, 'buttonLabel')}>
							{s.buttonLabel}<Icon name="lucide:arrow-right" class="size-4" />
						</a>
					</div>
				</div>
			))}
		</div>
	</div>
</section>
