---
import { Icon } from 'astro-icon/components';
import { tinaField } from '@tinacms/astro/tina-field';
import Btn from '../ui/Btn.astro';
import FormExtras from '../ui/FormExtras.astro';
import type { Home } from '../../lib/data';

interface Props { data: NonNullable<Home['priceBand']> }
const { data } = Astro.props;
---
<section class="section-ink py-16 md:py-20">
	<div class="container-k grid items-center gap-10 lg:grid-cols-[auto_1fr] lg:gap-16">
		<div class="reveal">
			<p class="text-ink-muted" data-tina-field={tinaField(data, 'label')}>{data.label}</p>
			<p class="text-5xl font-extrabold md:text-6xl" data-tina-field={tinaField(data, 'price')}>{data.price} €</p>
			<p class="mt-3 flex items-center gap-2 text-sm text-ink-muted" data-tina-field={tinaField(data, 'note')}><Icon name="lucide:check" class="size-4 text-primary" />{data.note}</p>
		</div>
		<div class="reveal" style="transition-delay:100ms">
			<form data-contact-form action="/api/contacto" method="post" class="relative grid gap-3 sm:grid-cols-2 lg:grid-cols-[1fr_1fr_1fr_1.2fr_auto]">
				<input name="nombre" aria-label="Nombre" placeholder="Nombre" autocomplete="name" class="field" />
				<input name="email" aria-label="Email" type="email" placeholder="Email" autocomplete="email" class="field" />
				<input name="telefono" aria-label="Teléfono" type="tel" placeholder="Teléfono" autocomplete="tel" class="field" />
				<input name="mensaje" aria-label="Qué web necesitas" placeholder="¿Qué web necesitas?" class="field" />
				<Btn type="submit" arrow class="sm:col-span-2 lg:col-span-1" data-tina-field={tinaField(data, 'buttonLabel')}>{data.buttonLabel}</Btn>
				<FormExtras source="banda-precio" statusClass="sm:col-span-2 lg:col-span-5" />
			</form>
			<p class="mt-3 text-xs text-ink-muted">Déjanos un email o un teléfono. Al enviar aceptas nuestra <a href="/legal/privacidad" class="underline hover:text-primary">política de privacidad</a>.</p>
		</div>
	</div>
</section>
