---
import { Icon } from 'astro-icon/components';
import { tinaField } from '@tinacms/astro/tina-field';
import SectionHead from '../ui/SectionHead.astro';
import { list, type Home } from '../../lib/data';

interface Props { data: NonNullable<Home['projects']> }
const { data } = Astro.props;
const projects = list(data.items);
// La lista se pinta dos veces seguidas para que el carrusel gire sin cortes.
const loop = [...projects.map((p, i) => ({ p, i, copy: false })), ...projects.map((p, i) => ({ p, i, copy: true }))];
---
<section id="proyectos" class="overflow-hidden py-20 md:py-28">
	<div class="reveal container-k">
		<SectionHead eyebrow={data.eyebrow} title={data.title} eyebrowField={tinaField(data, 'eyebrow')} titleField={tinaField(data, 'title')} />
	</div>
	<div class="mt-12 overflow-x-auto pb-4 [scrollbar-width:none] md:overflow-hidden">
		<div class="marquee flex w-max gap-6 px-5">
			{loop.map(({ p, i, copy }) => (
				<button
					type="button"
					class="card-lift w-[290px] shrink-0 overflow-hidden rounded-lg border bg-card text-left sm:w-[380px]"
					data-project
					data-name={p.name ?? ''}
					data-description={p.description ?? ''}
					data-tag={p.tag ?? ''}
					data-image={p.image ?? ''}
					data-url={p.url ?? ''}
					aria-hidden={copy ? 'true' : undefined}
					tabindex={copy ? -1 : undefined}
					data-tina-field={copy ? undefined : tinaField(p)}
				>
					{p.image && <img src={p.image} alt={copy ? '' : `Captura de ${p.name}`} loading="lazy" width="1280" height="800" class="aspect-[16/10] w-full object-cover object-top" />}
					<div class="p-5">
						{p.tag && <span class="rounded-full bg-muted px-2.5 py-1 text-xs font-medium text-muted-foreground">{p.tag}</span>}
						<h3 class="mt-3 text-lg font-bold">{p.name}</h3>
						<p class="text-sm text-muted-foreground">{p.description}</p>
					</div>
				</button>
			))}
		</div>
	</div>

	<dialog id="project-dialog" aria-labelledby="project-dialog-title">
		<div class="relative overflow-hidden rounded-xl bg-card shadow-2xl">
			<img data-slot="image" src="" alt="" class="aspect-[16/10] w-full object-cover object-top" />
			<div class="flex flex-col gap-4 p-6 sm:flex-row sm:items-end sm:justify-between">
				<div>
					<span data-slot="tag" class="rounded-full bg-muted px-2.5 py-1 text-xs font-medium text-muted-foreground"></span>
					<h3 id="project-dialog-title" data-slot="name" class="mt-3 text-2xl font-bold"></h3>
					<p data-slot="description" class="mt-1 text-muted-foreground"></p>
				</div>
				<a data-slot="url" href="#" target="_blank" rel="noreferrer noopener"
					class="btn-arrow inline-flex items-center justify-center gap-2 rounded-lg bg-primary px-5 py-3 text-sm font-semibold whitespace-nowrap text-primary-foreground transition-colors hover:bg-primary-hover">
					Ver web <Icon name="lucide:external-link" class="size-4" />
				</a>
			</div>
			<button type="button" data-close-dialog aria-label="Cerrar" class="absolute right-3 top-3 grid size-9 place-items-center rounded-full bg-card/90 text-foreground">
				<Icon name="lucide:x" class="size-5" />
			</button>
		</div>
	</dialog>
</section>
