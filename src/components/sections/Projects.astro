---
import { Icon } from 'astro-icon/components';
import SectionHead from '../ui/SectionHead.astro';
import Btn from '../ui/Btn.astro';
import { list, type Home } from '../../lib/data';

interface Props { data: NonNullable<Home['projects']> }
const { data } = Astro.props;
const projects = list(data.items);
// Con un solo proyecto se muestra en grande; con más, en cuadrícula.
const single = projects.length === 1;
---
<section id="proyectos" class="py-20 md:py-28">
	<div class="container-k">
		<div class="reveal">
			<SectionHead eyebrow={data.eyebrow} title={data.title} />
		</div>
		<div class:list={['mt-12 grid gap-6', !single && 'md:grid-cols-2 lg:grid-cols-3']}>
			{projects.map((p, i) => (
				<article class="reveal" style={`transition-delay:${i * 90}ms`}>
					<div class:list={['card-lift h-full overflow-hidden rounded-lg border bg-card', single && 'grid lg:grid-cols-[1.35fr_1fr]']}>
						{p.image && (
							<a href={p.caseStudy || p.url || undefined} class="block overflow-hidden bg-muted" tabindex="-1" aria-hidden="true">
								<img src={p.image} alt="" loading="lazy" width="1280" height="800" class="aspect-[16/10] h-full w-full object-cover object-top" />
							</a>
						)}
						<div class:list={['flex flex-col p-6', single && 'lg:p-10']}>
							{p.tag && <span class="self-start rounded-full bg-muted px-2.5 py-1 text-xs font-medium text-muted-foreground">{p.tag}</span>}
							<h3 class:list={['mt-3 font-bold', single ? 'text-2xl md:text-3xl' : 'text-lg']}>{p.name}</h3>
							<p class="mt-2 text-muted-foreground">{p.description}</p>
							<div class="mt-auto flex flex-wrap gap-3 pt-7">
								{p.caseStudy && <Btn href={p.caseStudy} arrow>Ver el caso</Btn>}
								{p.url && (
									<Btn href={p.url} target="_blank" variant="outline">
										Visitar la web <Icon name="lucide:external-link" class="size-4" />
									</Btn>
								)}
							</div>
						</div>
					</div>
				</article>
			))}
		</div>
	</div>
</section>
