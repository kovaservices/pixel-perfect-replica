---
import { Icon } from 'astro-icon/components';
import { tinaField } from '@tinacms/astro/tina-field';
import Btn from '../ui/Btn.astro';
import SectionHead from '../ui/SectionHead.astro';
import { list, type Home } from '../../lib/data';

interface Props { data: NonNullable<Home['plans']> }
const { data } = Astro.props;
const plans = list(data.items);
const custom = data.custom;
const tags = list(custom?.tags);
---
<section class="bg-sand py-20 md:py-28">
	<div class="container-k">
		<div class="reveal mx-auto max-w-2xl text-center">
			<SectionHead eyebrow={data.eyebrow} title={data.title} eyebrowField={tinaField(data, 'eyebrow')} titleField={tinaField(data, 'title')} />
		</div>
		<div class="mt-14 grid items-center gap-6 lg:grid-cols-3">
			{plans.map((p, i) => (
				<div class="reveal" style={`transition-delay:${i * 90}ms`}>
					<div class:list={['card-lift relative rounded-lg border bg-card p-7', p.featured && 'border-2 border-primary lg:scale-105 lg:py-10']} data-tina-field={tinaField(p)}>
						{p.featured && p.badge && (
							<span class="absolute -top-3 left-7 rounded-full bg-primary px-3 py-1 text-xs font-bold uppercase tracking-wider text-primary-foreground" data-tina-field={tinaField(p, 'badge')}>{p.badge}</span>
						)}
						<h3 class="text-xl font-bold" data-tina-field={tinaField(p, 'name')}>{p.name}</h3>
						<p class="mt-1 text-sm text-muted-foreground" data-tina-field={tinaField(p, 'description')}>{p.description}</p>
						<p class="mt-6 flex flex-wrap items-baseline gap-x-2">
							<span class="text-4xl font-extrabold" data-tina-field={tinaField(p, 'price')}>{p.price} €</span>
							{p.priceExtra && <span class="text-lg font-bold text-primary-strong" data-tina-field={tinaField(p, 'priceExtra')}>{p.priceExtra}</span>}
						</p>
						<ul class="mt-6 space-y-3 text-sm">
							{list(p.features).map((f, j) => (
								<li class="flex gap-2.5" data-tina-field={tinaField(p, 'features', j)}>
									<Icon name="lucide:check" class="size-4 shrink-0 translate-y-0.5 text-primary-strong" />{f}
								</li>
							))}
						</ul>
						<Btn href="#contacto" arrow variant={p.featured ? 'primary' : 'outline'} class="mt-8 w-full" data-tina-field={tinaField(p, 'buttonLabel')}>{p.buttonLabel}</Btn>
					</div>
				</div>
			))}
		</div>

		{custom && (custom.title || custom.text) && (
			<div class="reveal mt-14">
				<div class="section-ink grid-texture grid items-center gap-8 overflow-hidden rounded-xl p-8 md:p-10 lg:grid-cols-[1fr_auto] lg:gap-14" data-tina-field={tinaField(custom)}>
					<div class="flex gap-5">
						<span class="hidden size-12 shrink-0 place-items-center rounded-lg bg-primary text-primary-foreground sm:grid">
							<Icon name="lucide:code-xml" class="size-6" />
						</span>
						<div>
							<h3 class="text-2xl font-extrabold md:text-3xl" data-tina-field={tinaField(custom, 'title')}>{custom.title}</h3>
							<p class="mt-3 max-w-2xl text-ink-muted" data-tina-field={tinaField(custom, 'text')}>{custom.text}</p>
							{tags.length > 0 && (
								<ul class="mt-5 flex flex-wrap gap-2">
									{tags.map((t, i) => (
										<li class="rounded-full border border-ink-border px-3 py-1 text-xs font-medium text-ink-foreground/90" data-tina-field={tinaField(custom, 'tags', i)}>{t}</li>
									))}
								</ul>
							)}
						</div>
					</div>
					<Btn href="/#contacto" arrow class="justify-self-start py-3.5 lg:justify-self-end" data-tina-field={tinaField(custom, 'buttonLabel')}>{custom.buttonLabel}</Btn>
				</div>
			</div>
		)}
	</div>
</section>
