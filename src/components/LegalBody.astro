---
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import type { Legal } from '../lib/data';

interface Props { data?: Legal | null }
const { data } = Astro.props;
---
{data && (
	<>
		<section class="section-ink grid-texture pt-32 pb-14 md:pt-40 md:pb-16">
			<div class="container-k">
				<p class="eyebrow">Legal</p>
				<h1 class="mt-3 text-4xl font-extrabold md:text-5xl" data-tina-field={tinaField(data, 'title')}>{data.title}</h1>
				{data.updated && <p class="mt-4 text-sm text-ink-muted" data-tina-field={tinaField(data, 'updated')}>Última actualización: {data.updated}</p>}
			</div>
		</section>
		<section class="py-14 md:py-20">
			<div class="container-k">
				<div class="legal-prose max-w-3xl" data-tina-field={tinaField(data, 'body')}>
					<TinaMarkdown content={data.body} />
				</div>
				<a href="/" class="mt-12 inline-flex items-center gap-2 text-sm font-semibold text-primary-strong hover:underline">← Volver a la web</a>
			</div>
		</section>
	</>
)}
