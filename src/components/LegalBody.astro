---
interface Props { title: string; updated?: string | null }
const { title, updated } = Astro.props;
---
<section class="section-ink grid-texture pt-32 pb-14 md:pt-40 md:pb-16">
	<div class="container-k">
		<p class="eyebrow">Legal</p>
		<h1 class="mt-3 text-4xl font-extrabold md:text-5xl">{title}</h1>
		{updated && <p class="mt-4 text-sm text-ink-muted">Última actualización: {updated}</p>}
	</div>
</section>
<section class="py-14 md:py-20">
	<div class="container-k">
		<div class="legal-prose max-w-3xl">
			<slot />
		</div>
		<a href="/" class="mt-12 inline-flex items-center gap-2 text-sm font-semibold text-primary-strong hover:underline">← Volver a la web</a>
	</div>
</section>
