---
interface Props {
	eyebrow?: string | null;
	title?: string | null;
	class?: string;
}
const { eyebrow, title, class: className = '' } = Astro.props;
---
<div class={className}>
	{eyebrow && <p class="eyebrow">{eyebrow}</p>}
	{title && <h2 class="mt-3 text-3xl font-extrabold md:text-[2.75rem]">{title}</h2>}
</div>
